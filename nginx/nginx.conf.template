# ============================================================================
#  nginx как L4-маршрутизатор по SNI для Remnawave Node
#
#  ВАЖНО: nginx здесь НЕ терминирует TLS. Он читает имя сервера из
#  незашифрованной части TLS ClientHello (ssl_preread) и пересылает поток
#  целиком в нужный инбаунд Xray. Сертификаты, ключи, Reality — всё это
#  остаётся на стороне ноды. Поэтому здесь нет ни ssl_certificate,
#  ни listen 443 ssl, ни proxy_ssl_*, ни http{} блоков — и не должно быть.
#
#  Этот файл генерируется из шаблона: ./scripts/configure.sh
#  Правки вносите в nginx/nginx.conf.template, а не в результат.
# ============================================================================

user  nginx;
worker_processes  auto;

# Потолок дескрипторов на воркер. Одно клиентское соединение занимает два:
# сокет к клиенту и сокет к бэкенду.
worker_rlimit_nofile 65535;

error_log  /var/log/nginx/error.log warn;
pid        /run/nginx.pid;

events {
    # 16384 * число воркеров / 2 = примерный потолок одновременных клиентов.
    worker_connections  16384;
    multi_accept        on;
}

stream {
    # ------------------------------------------------------------------
    #  Логи
    # ------------------------------------------------------------------
    # По умолчанию выключены: на прокси-ноде лог соединений — это лог
    # пользователей. Включайте только на время отладки.
    log_format  sni_routing  '$remote_addr [$time_local] '
                             'sni="$ssl_preread_server_name" '
                             'alpn="$ssl_preread_alpn_protocols" '
                             '-> $remnawave_backend status=$status '
                             'sent=$bytes_sent recv=$bytes_received '
                             'time=$session_time';
    access_log  off;
    # Для отладки заменить строку выше на:
    # access_log /var/log/nginx/stream.log sni_routing;

    # ------------------------------------------------------------------
    #  Таблица маршрутизации по SNI
    # ------------------------------------------------------------------
    #  Ключ слева — это ЗНАЧЕНИЕ ИЗ realitySettings.serverNames соответству-
    #  ющего инбаунда, то есть маскировочный домен. НЕ домен вашей ноды:
    #  при Reality домен ноды в ClientHello вообще не передаётся.
    #
    #  Значения должны совпадать с xray/xray-config.json один в один.
    #  Оба файла генерируются из одного .env, поэтому расхождений быть
    #  не должно — но при ручной правке следите за этим.
    # ------------------------------------------------------------------
    map $ssl_preread_server_name $remnawave_backend {
        # Сопоставление доменных имён: без учёта регистра.
        # Клиенты присылают SNI в нижнем регистре, но полагаться на это не стоит.
        hostnames;

        __SNI_TCP__      127.0.0.1:__PORT_TCP__;    # VLESS RAW  + Reality (Vision)
        __SNI_GRPC__     127.0.0.1:__PORT_GRPC__;   # VLESS gRPC + Reality
        __SNI_XHTTP__    127.0.0.1:__PORT_XHTTP__;  # VLESS XHTTP + Reality

        # Неизвестный или пустой SNI — то есть сканер, бот или случайный
        # заход браузером. Отправляем на Reality-инбаунд: он не пройдёт
        # проверку и Xray прозрачно отдаст соединение реальному
        # __SNI_TCP__. Снаружи сервер выглядит как обычный сайт.
        default          127.0.0.1:__PORT_TCP__;
    }

    server {
        listen 443 reuseport;

        # Раскомментируйте, если на сервере есть работающий IPv6.
        # Если IPv6 в ядре отключён, эта строка помешает nginx стартовать.
        # listen [::]:443 reuseport;

        ssl_preread  on;
        proxy_pass   $remnawave_backend;

        # ------------------------------------------------------------------
        #  PROXY protocol: передаёт Xray реальный IP клиента.
        #  Без этого все пользователи в панели будут онлайн с 127.0.0.1,
        #  перестанут работать лимиты по устройствам и геороутинг.
        #
        #  Требует "acceptProxyProtocol": true в sockopt каждого инбаунда.
        #  Побочный эффект — полезный: к 127.0.0.1:__PORT_TCP__ больше нельзя
        #  подключиться напрямую, без PROXY-заголовка соединение рвётся.
        # ------------------------------------------------------------------
        proxy_protocol  on;

        # Бэкенд на loopback — если он не ответил за 5 секунд, он мёртв.
        proxy_connect_timeout  5s;

        # Час простоя. Меньше ставить не стоит: idle-сессии (SSH, мессенджеры,
        # открытые вкладки) будут рваться, и пользователь увидит это как
        # "интернет отваливается".
        proxy_timeout  1h;
    }
}
