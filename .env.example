# ============================================================================
#  Remnawave Node — параметры развёртывания
#  Скопировать в .env и заполнить:  cp .env.example .env
#  Файл .env содержит секреты и в git не попадает (см. .gitignore).
# ============================================================================

# ---------------------------------------------------------------------------
#  1. ПОДКЛЮЧЕНИЕ К ПАНЕЛИ
# ---------------------------------------------------------------------------

# Выдаётся панелью при создании ноды: Nodes -> Create node -> кнопка копирования.
# Это не пароль, а сертификат ноды в base64. Длинная строка.
SECRET_KEY=

# Порт, на котором нода принимает команды от панели.
# Наружу открывать ТОЛЬКО для IP панели (см. scripts/firewall.sh).
NODE_PORT=2231

# IP панели Remnawave — используется скриптом фаервола.
PANEL_IP=203.0.113.10

# IP, с которого вы администрируете сервер по SSH.
# Оставьте пустым, если SSH должен быть открыт для всех (менее безопасно).
ADMIN_IP=

# ---------------------------------------------------------------------------
#  2. МАСКИРОВОЧНЫЕ ДОМЕНЫ (SNI) — ЯДРО СХЕМЫ
# ---------------------------------------------------------------------------
# Reality не использует ваш домен: клиент отправляет в TLS ClientHello имя
# маскировочного сайта. Именно по нему nginx разводит трафик с порта 443.
#
# Требования к домену-маске:
#   * поддерживает TLS 1.3, X25519 и HTTP/2;
#   * не за Cloudflare и не за другим крупным CDN;
#   * расположен географически близко к ноде (меньше задержка при подмене);
#   * не заблокирован в стране пользователей;
#   * У КАЖДОГО ИНБАУНДА СВОЙ, уникальный домен — иначе nginx не различит их.
#
# Проверить кандидата: openssl s_client -connect ДОМЕН:443 -tls1_3 -alpn h2 -brief

SNI_TCP=opensuse.org
SNI_GRPC=www.cloudflare.com
SNI_XHTTP=mask-xhttp.example.com

# ---------------------------------------------------------------------------
#  3. ВНУТРЕННИЕ ПОРТЫ ИНБАУНДОВ
# ---------------------------------------------------------------------------
# Слушаются Xray строго на 127.0.0.1, наружу не выставляются.
# Менять имеет смысл только при конфликте с другими сервисами.

PORT_TCP=4433
PORT_GRPC=5443
PORT_XHTTP=8443

# ---------------------------------------------------------------------------
#  4. ПАРАМЕТРЫ REALITY
# ---------------------------------------------------------------------------
# Сгенерировать: ./scripts/gen-reality-keys.sh
# Публичные ключи (public key) в этот файл не нужны — они указываются
# в панели, в разделе Hosts, и уходят клиенту в подписке.

REALITY_PRIVATE_KEY_TCP=
REALITY_PRIVATE_KEY_GRPC=
REALITY_PRIVATE_KEY_XHTTP=

# shortId: случайная hex-строка чётной длины, 2-16 символов.
# Генерация: openssl rand -hex 8
SHORT_ID_TCP=
SHORT_ID_GRPC=
SHORT_ID_XHTTP=

# ---------------------------------------------------------------------------
#  5. ПРОЧЕЕ
# ---------------------------------------------------------------------------

# Путь для инбаунда XHTTP. Произвольная строка, но пусть будет не угадываемой.
XHTTP_PATH=/a7f3c1b9e2

# Имя gRPC-сервиса. Маскируется под обычный gRPC-эндпоинт.
GRPC_SERVICE_NAME=postman-echo-grpc
